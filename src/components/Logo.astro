---
import { Image } from "astro:assets";
import logo from "../assets/images/logo-white.webp";
const { home } = Astro.props;
---

{/* Link to home if not on home page, put id on a */}
{
    home ? (
        <Image
            src={logo}
            priority
            alt="my summer radio logo"
            class="logo"
            id="logo"
            style="--fit: contain; --pos: center; min-width: 0; min-height: 0; overflow: hidden;"
            height="300"
        />
    ) : (
        <a id="logo" href="/">
            <Image
                src={logo}
                priority
                alt="my summer radio logo"
                class="logo"
                style="--fit: contain; --pos: center; min-width: 0; min-height: 0; overflow: hidden;"
                height="300"
            />
        </a>
    )
}
