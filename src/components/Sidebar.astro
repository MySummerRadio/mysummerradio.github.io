---
import { getEntry, type CollectionEntry } from "astro:content";
import { marked } from "marked";

export interface Props {
    id: string;
}

const { id } = Astro.props;

type SidebarEntry = CollectionEntry<"sidebars">;

const entry = await getEntry("sidebars", id);

if (!entry) {
    throw new Error(`Sidebar "${id}" not found`);
}
---

{
    entry.data.sections.map((item) => (
        <div class="box">
            <h3>{item.heading}</h3>
            <div set:html={marked(item.text)} />
        </div>
    ))
}

<style>
    .box {
        background: rgb(256, 256, 256, 0.75);
        color: black;
        padding: 1rem;
        box-shadow: 0 0.5rem 1rem #999;
    }
</style>
