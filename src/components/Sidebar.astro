---
import { getEntry, type CollectionEntry } from "astro:content";
import { markdownToHtml } from "satteri";

export interface Props {
    id: string;
}

const { id } = Astro.props;

type SidebarEntry = CollectionEntry<"sidebars">;

const entry = await getEntry("sidebars", id);

if (!entry) {
    throw new Error(`Sidebar "${id}" not found`);
}
---

{
    entry.data.sections.map((item) => (
        <div class="box">
            <h3>{item.heading}</h3>
            <div set:html={markdownToHtml(item.text).html} />
        </div>
    ))
}
