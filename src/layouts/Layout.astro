---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import { Image } from "astro:assets";
import Background from "../assets/images/foregrounds_99.webp";
import Cloud from "../assets/images/realistic-cloud_2.avif";
import SvgAssets from "../components/SvgAssets.astro";
import Silhouette from "../assets/images/silhouette.svg";

const { pageTitle, className } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" href="/favicon.ico" />
        <link rel="icon" type="image/png" href="/favicon.png" />
        <meta name="generator" content={Astro.generator} />
        <title>{pageTitle}</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Sansation:ital,wght@0,300;0,400;0,700;1,300;1,400;1,700&family=Zen+Loop:ital@0;1&display=swap"
            rel="stylesheet"
        />

        <!-- Matomo -->
        <script>
            // @ts-expect-error
            var _paq = (window._paq = window._paq || []);
            /* tracker methods like "setCustomDimension" should be called before "trackPageView" */
            _paq.push([
                "setDocumentTitle",
                document.domain + "/" + document.title,
            ]);
            _paq.push(["trackPageView"]);
            _paq.push(["enableLinkTracking"]);
            (function () {
                var u = "//matomo.ruechappe.eu/";
                _paq.push(["setTrackerUrl", u + "matomo.php"]);
                _paq.push(["setSiteId", "7"]);
                var d = document,
                    g = d.createElement("script"),
                    s = d.getElementsByTagName("script")[0];
                g.async = true;
                g.src = u + "matomo.js";
                // @ts-expect-error
                s.parentNode.insertBefore(g, s);
            })();
        </script>
        <!-- End Matomo Code -->
        <ClientRouter />
    </head>
    <body class:list={[className]}>
        <SvgAssets />
        <Image
            src={Cloud}
            id="cloud"
            alt=""
            style="position: absolute; top: 25%; left: 0; z-index: -10;"
            priority
        />
        <main>
            <slot />
        </main>
        <figure class="silhouette">
            <Silhouette height="33.333vh" style="fill: var(--white);" />
        </figure>
        <footer>
            <Image
                src={Background}
                alt="background"
                style="width: 100%;"
                priority
            />
        </footer>
    </body>
</html>

<style is:global>
    body {
        --text-color: var(--earth-color);

        margin: 0;
        width: 100%;
        min-height: 100vh;
        font-family: var(--text-font);
        font-weight: 300;
        font-size: 1.2rem;
        color: var(--text-color);
        display: grid;
        grid-template-columns: repeat(12, minmax(10px, 1fr));
        grid-template-rows: repeat(5, minmax(10px, 16.6667vh)) 1fr;
        background: linear-gradient(
            to bottom,
            #fff,
            var(--sky-color) 10%,
            var(--sky-color) 80%,
            var(--sky-color-light) 90%
        );
    }

    main {
        display: grid;
        grid-column: 1 / span 12;
        grid-row: 1 / span 5;
        grid-template-columns: subgrid;
        grid-template-rows: subgrid;
    }

    .home {
        & main {
            grid-template-areas:
                "logo logo logo logo logo logo . . menu1 menu1 menu1 ."
                "logo logo logo logo logo logo . . . . . ."
                ". . . . . . menu2 menu2 menu2 . . ."
                "menu4 menu4 menu4 menu3 menu3 menu3 . . . . . ."
                ". . . . . . . . . . . .";

            @media (max-width: 768px) {
                grid-template-areas:
                    ". logo logo logo logo logo logo logo logo logo logo ."
                    ". . . menu1 menu1 menu1 . . . . . ."
                    ". menu2 menu2 menu2 . . . . . . . ."
                    ". . . menu3 menu3 menu3 . . . . . ."
                    ". menu4 menu4 menu4 . . . . . . . .";

                :is(#menu1, #menu2, #menu3, #menu4) {
                    padding: 0;
                    place-self: start;
                    z-index: 100;
                }
            }
        }
    }

    .blog {
        & main {
            grid-template-areas:
                "logo logo logo logo . . . . . . . ."
                "logo logo logo logo . . . . . . . ."
                ". . . list list list list list list  . . ."
                ". . . list list list list list list  . . ."
                ". . . list list list list list list  . . .";

            @media (max-width: 768px) {
                grid-template-areas:
                    "logo logo logo logo logo logo logo logo logo logo logo ."
                    ". list list list list list list list list list . ."
                    ". list list list list list list list list list . ."
                    ". list list list list list list list list list . ."
                    ". . . . . . . . . . . .";
            }
        }

        & #logo {
            /*filter: drop-shadow(0 0 1px var(--earth-color));*/
        }
    }

    .post {
        & main {
            grid-template-areas:
                "logo logo logo logo . . . . . . . ."
                "logo logo logo logo . . . . . . . ."
                ". . . content content content content content content  . . ."
                ". . . content content content content content content  . . ."
                ". . . . . . . . . . . .";

            @media (max-width: 768px) {
                grid-template-areas:
                    "logo logo logo logo logo logo logo logo logo logo logo ."
                    ". content content content content content content content content content content ."
                    ". content content content content content content content content content content ."
                    ". content content content content content content content content content content ."
                    ". . . . . . . . . . . .";
            }
        }

        & #content {
            grid-area: content;
        }
    }

    #logo {
        grid-area: logo;
        padding-block-start: 2vw;
        padding-inline-start: 2vw;
        place-self: center end;
    }

    :is(.home, .blog, .post) .silhouette {
        grid-column: 10 / span 2;
        grid-row: 4 / span 3;
        place-self: end center;
        padding-block-end: 4vh;
        z-index: 10;

        @media (max-width: 768px) {
            place-self: end;
            padding-block-end: 1vh;
            transform: scale(0.6667);
        }
    }

    #cloud {
        transform: scale(0.8) translate(10vw, 0);
        animation: cloud-drift 30s ease-in-out infinite;
    }

    @keyframes cloud-drift {
        0%,
        15% {
            transform: scale(0.8) translate(10vw, 0);
            animation-timing-function: ease-in-out;
        }
        50% {
            transform: scale(0.84) translate(10.5vw, -0.5vh);
            animation-timing-function: ease-in-out;
        }
        85%,
        100% {
            transform: scale(0.8) translate(10vw, 0);
        }
    }

    footer {
        grid-column: 1 / span 12;
        grid-row: 6 / span 1;
        display: grid;
        grid-template-columns: subgrid;
        grid-template-rows: auto;

        clip-path: url(#clip-grass2);
        background: linear-gradient(
            to bottom,
            var(--grass-color),
            var(--grass-color-dark) 45%
        );
        height: 16.65vh;
        overflow: hidden;

        & img {
            grid-column: 1 / -1;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
    }
</style>
