---
import "../styles/global.css";
import background from "../assets/background.svg";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import SvgAssets from "../components/SvgAssets.astro";
import Silhouette from "../assets/images/silhouette.svg";

const { pageTitle, className } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" href="/favicon.ico" />
        <link rel="icon" type="image/png" href="/favicon.png" />
        <meta name="generator" content={Astro.generator} />
        <title>{pageTitle}</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Sansation:ital,wght@0,300;0,400;0,700;1,300;1,400;1,700&family=Zen+Loop:ital@0;1&display=swap"
            rel="stylesheet"
        />
        <!-- Matomo -->
        <script>
            // @ts-expect-error
            var _paq = (window._paq = window._paq || []);
            /* tracker methods like "setCustomDimension" should be called before "trackPageView" */
            _paq.push([
                "setDocumentTitle",
                document.domain + "/" + document.title,
            ]);
            _paq.push(["trackPageView"]);
            _paq.push(["enableLinkTracking"]);
            (function () {
                var u = "//matomo.ruechappe.eu/";
                _paq.push(["setTrackerUrl", u + "matomo.php"]);
                _paq.push(["setSiteId", "7"]);
                var d = document,
                    g = d.createElement("script"),
                    s = d.getElementsByTagName("script")[0];
                g.async = true;
                g.src = u + "matomo.js";
                // @ts-expect-error
                s.parentNode.insertBefore(g, s);
            })();
        </script>
        <!-- End Matomo Code -->
    </head>
    <body class:list={[className]}>
        <SvgAssets />
        <main>
            <slot />
        </main>
        <figure class="silhouette">
            <Silhouette height="35vh" style="fill: var(--white);" />
        </figure>
        <footer></footer>
    </body>
</html>

<style is:global>
    body {
        margin: 0;
        width: 100%;
        min-height: 100vh;
        font-family: "aoharu", cursive;
        font-weight: 300;
        color: var(--earth-color);
        display: grid;
        grid-template-columns: repeat(12, minmax(10px, 1fr));
        grid-template-rows: repeat(6, minmax(10px, 1fr));
        background: linear-gradient(
            to bottom,
            #fff,
            var(--sky-color) 20%,
            var(--sky-color) 80%,
            var(--sky-color-light) 90%
        );
    }

    main {
        display: grid;
        grid-column: 1 / span 12;
        grid-row: 1 / span 5;
        grid-template-columns: subgrid;
        grid-template-rows: subgrid;
    }

    .home main {
        grid-template-areas:
            "logo logo logo logo logo logo . . menu1 menu1 menu1 ."
            "logo logo logo logo logo logo . . . . . ."
            ". . . . . . menu2 menu2 menu2 . . ."
            "menu4 menu4 menu4 menu3 menu3 menu3 . . . . . ."
            ". . . . . . . . . . . .";
    }

    .home .silhouette {
        grid-column: 10 / span 2;
        grid-row: 4 / span 3;
        place-self: center;
        /*height: 20vh;*/
        z-index: 10;
    }

    footer {
        grid-column: 1 / span 12;
        grid-row: 6 / span 1;
        display: grid;
        grid-template-columns: subgrid;
        grid-template-rows: auto;

        clip-path: url(#clip-grass);
        background: linear-gradient(
            to bottom,
            var(--grass-color),
            var(--grass-color-dark)
        );
        height: 100%;
    }
</style>
