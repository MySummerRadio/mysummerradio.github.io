---
// src/layouts/HomeLayout.astro
import BaseLayout from "./BaseLayout.astro";
import { Image } from "astro:assets";
import Background from "@/assets/images/foregrounds_99.webp";

const { pageTitle } = Astro.props;
---

<BaseLayout pageTitle={pageTitle}>
    <div class="home-content">
        <slot />
    </div>

    <div slot="footer">
        <footer>
            <Image
                src={Background}
                alt="background"
                style="width: 100%;"
                priority
            />
        </footer>
    </div>
</BaseLayout>

<style is:global>
    .home-content {
        --grid-row-height: minmax(10px, 14.6667vh);

        margin-inline: 2vw;
        display: grid;
        grid-template-columns: subgrid;
        grid-template-rows: repeat(5, var(--grid-row-height)) 1fr;
        grid-template-areas:
            "logo logo logo logo logo logo . . menu1 menu1 menu1 ."
            "logo logo logo logo logo logo . . . . . ."
            ". . . . . . menu2 menu2 menu2 . . ."
            "menu4 menu4 menu4 . . . . . . . . ."
            ". . . menu3 menu3 menu3 . . . . . .";

        @media (max-width: 768px) {
            grid-template-areas:
                ". logo logo logo logo logo logo logo logo logo logo ."
                ". . . . . . . . . . . ."
                ". menu menu menu menu menu menu . . . . ."
                ". menu menu menu menu menu menu . . . . ."
                ". menu menu menu menu menu menu . . . . .";

            .menu {
                display: flex;
                flex-direction: column;
                gap: 1rem;
                grid-area: menu;
            }

            :is(#menu1, #menu2, #menu3, #menu4) {
                padding: 0;
                place-self: start;
                z-index: 100;
                grid-area: unset;
            }
        }
    }

    footer {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        height: 16.65vh;
        overflow: hidden;
        grid-column: 1 / span 12;
        grid-row: 6 / span 1;
        display: grid;
        grid-template-columns: subgrid;
        grid-template-rows: auto;

        clip-path: url(#clip-grass2);
        background: linear-gradient(
            to bottom,
            oklch(0.944 0.155 111.002),
            var(--grass-color),
            var(--grass-color-dark) 60%
        );

        & img {
            grid-column: 1 / -1;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
    }
</style>
