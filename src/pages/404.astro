---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="404">
    <article>
        <p></p>
        <h1>SORRY, NOTHING HERE</h1>
        <a href="/" style="color: white; font-weight: normal;">Back 2 home</a>
    </article>
</Layout>

<style>
    article {
        grid-column: 1 / -1;
        grid-row: 1 / -1;
        min-height: 80vh;
        display: grid;
        grid-template-columns: subgrid;
        color: white;
        font-weight: bold;
        place-self: center;
        text-align: center;

        & > * {
            grid-column: 1 / -1;
            place-self: center;
            text-align: center;
        }
    }
</style>
