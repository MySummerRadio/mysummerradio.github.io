---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
type ReviewEntry = CollectionEntry<"reviews">;
import Logo from "../../components/Logo.astro";

// 1. Generate a new path for every collection entry
export async function getStaticPaths() {
    const reviews: ReviewEntry[] = await getCollection("reviews");
    return reviews.map((review) => ({
        params: { id: review.id },
        props: { review },
    }));
}

// 2. For your template, you can get the entry directly from the prop
const { review } = Astro.props;
const { Content } = await render(review);
const pageTitle = review.data.title;
const className = "post";
---

<Layout title={pageTitle} className={className}>
    <Logo />
    <div id="content" class="content">
        <h1>{pageTitle}</h1>
        <Content />
    </div>
</Layout>

<style>
    .content {
    }
</style>
