---
import Layout from "@/layouts/Layout.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import Logo from "@/components/Logo.astro";
import About from "@/content/about.md";
import BlogEntryLi from "@/components/BlogEntryLi.astro";
type BlogEntry = CollectionEntry<"blog">;

const posts = (await getCollection("blog"))
    .filter((post) => post.data.published)
    .sort(
        (a: BlogEntry, b: BlogEntry): number =>
            b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
    );
const pageTitle = "My Summer Blog";
const className = "blog";
---

<Layout pageTitle={pageTitle} className={className}>
    <Logo />
    <h1 id="pagetitle" data-label="SECRETS">
        SECRETS
    </h1>
    <div id="about" class="flow prose sidebar">
        <About />
    </div>
    <ul id="list">
        {posts.map((post: BlogEntry) => (
            <BlogEntryLi post={post} />
        ))}
    </ul>
</Layout>

<style>
    #list {
        grid-area: list;
        margin-block-end: 16.6667vh;
        display: flex;
        flex-direction: column;
        gap: var(--step-0);
    }

    #about {
        grid-area: about;
        margin-block-end: 16.6667vh;
        color: var(--dark-blue);
    }
</style>
