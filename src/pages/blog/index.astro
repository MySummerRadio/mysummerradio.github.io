---
import Layout from "@/layouts/Layout.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import Logo from "@/components/Logo.astro";
import About from "@/content/about.md";
type BlogEntry = CollectionEntry<"blog">;

const posts = (await getCollection("blog"))
    .filter((post) => post.data.published)
    .sort(
        (a: BlogEntry, b: BlogEntry): number =>
            b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
    );
const pageTitle = "My Summer Blog";
const className = "blog";
---

<Layout pageTitle={pageTitle} className={className}>
    <Logo />
    <div id="about" class="flow prose sidebar">
        <About />
    </div>
    <ul id="list">
        {
            posts.map((post: BlogEntry) => (
                <li>
                    <a href={`/blog/${post.id}`}>
                        {post.data.pubDate}: {post.data.title}
                    </a>
                </li>
            ))
        }
    </ul>
</Layout>

<style>
    #list {
        grid-area: list;
        margin-block-end: 16.6667vh;
    }

    #about {
        grid-area: about;
        margin-block-end: 16.6667vh;
    }

    .sidebar {
        font-size: 1rem;
    }
</style>
