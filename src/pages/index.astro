---
import Layout from "../layouts/Layout.astro";
import Logo from "../components/Logo.astro";
import { getCollection, type CollectionEntry } from "astro:content";
type SidebarEntry = CollectionEntry<"sidebars">;
const sidebars: SidebarEntry[] = await getCollection("sidebars");

const pageTitle = "My Summer Radio";
const className = "home";
---

<Layout pageTitle={pageTitle} className={className}>
    <Logo home />
    <div id="menu1"><a class="menu-link" href="/blog"><h1>Blog</h1></a></div>
    <div id="menu2"><a class="menu-link" href="#"><h1>Downloads</h1></a></div>
    <div id="menu3"><a class="menu-link" href="#"><h1>Stuff</h1></a></div>
    <div id="menu4"><a class="menu-link" href="#"><h1>Reviews</h1></a></div>
</Layout>

<style is:global>
    #menu1 {
        grid-area: menu1;
        place-self: end center;
    }

    #menu2 {
        grid-area: menu2;
        place-self: center;
    }

    #menu3 {
        grid-area: menu3;
        place-self: end;
    }

    #menu4 {
        grid-area: menu4;
        place-self: start;
    }
</style>
