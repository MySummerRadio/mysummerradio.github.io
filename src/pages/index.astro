---
import Layout from "../layouts/Layout.astro";
import Blog from "../components/Blog.astro";
import Sidebar from "../components/Sidebar.astro";

import { getCollection, type CollectionEntry } from "astro:content";
type SidebarEntry = CollectionEntry<"sidebars">;
const sidebars: SidebarEntry[] = await getCollection("sidebars");

const pageTitle = "My Summer Radio";
---

<Layout pageTitle={pageTitle}>
    <div class="container">
        <h1>=== Welcome to My Summer Radio :) ===</h1>
        <div class="col left">
            <h2>left col</h2>
            <Sidebar id="sidebar-left" />
        </div>
        <div class="col center">
            <h2>Blog</h2>
            <Blog />
        </div>
        <div class="col right">
            <h2>right col</h2>
            <Sidebar id="sidebar-right" />
        </div>
    </div>
</Layout>

<style>
    .container {
        display: grid;
        grid-template-columns: 1fr 2fr 1fr;
        gap: 2vw;
        max-width: 1200px;
        margin-inline: auto;
    }

    h1 {
        grid-column: 1 / -1;
        place-self: center;
        text-align: center;
        text-transform: uppercase;
        font-size: 3rem;
        font-weight: 800;
        animation-name: glow;
        animation-duration: 2s;
        animation-iteration-count: infinite;
    }

    h2 {
        text-align: center;
    }

    .col {
        display: grid;
        align-items: start;
        width: 100%;
        grid-template-columns: 1fr;
        grid-auto-rows: min-content;
        gap: 2vw;
    }

    .center {
        background: rgb(256, 256, 256, 0.8);
        color: black;
        padding: 1rem;
        box-shadow: 0 0.5rem 1rem #999;
        min-height: 50vh;
    }

    /* from https://github.com/patriciamolnar/tutorials/tree/master/Variable%20Fonts */

    @keyframes glow {
        0% {
            text-shadow: var(--shadow);
        }
        50% {
            text-shadow: var(--shadow2);
        }
        100% {
            text-shadow: var(--shadow);
        }
    }
</style>
