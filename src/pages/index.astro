---
import Layout from "../layouts/Layout.astro";
import Blog from "../components/Blog.astro";
import Sidebar from "../components/Sidebar.astro";

import { getCollection, type CollectionEntry } from "astro:content";
type SidebarEntry = CollectionEntry<"sidebars">;
const sidebars: SidebarEntry[] = await getCollection("sidebars");

const pageTitle = "My Summer Radio";
---

<Layout pageTitle={pageTitle}>
    <div class="container">
        <h1>Welcome to My Summer Radio :)</h1>
        <div class="col left">
            <h2>left col</h2>
            <Sidebar id="sidebar-left" />
        </div>
        <div class="col center box">
            <h2>Blog</h2>
            <Blog />
        </div>
        <div class="col right">
            <h2>right col</h2>
            <Sidebar id="sidebar-right" />
        </div>
    </div>
</Layout>

<style>
    .container {
        display: grid;
        grid-template-columns: 1fr 2fr 1fr;
        gap: 2vw;
        max-width: 1200px;
        margin-inline: auto;
    }

    h1 {
        grid-column: 1 / -1;
        place-self: center;
        text-align: center;
        font-size: 3rem;
        font-weight: 800;
    }

    h2 {
        text-align: center;
    }

    .col {
        display: grid;
        align-items: start;
        width: 100%;
        grid-template-columns: 1fr;
        grid-auto-rows: min-content;
        gap: 2vw;
    }

    .center {
        min-height: 50vh;
    }
</style>
