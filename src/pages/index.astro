---
import Layout from "../layouts/Layout.astro";

const pageTitle = "My Summer Radio";
---

<Layout pageTitle={pageTitle}>
    <div class="container">
        <h1>=== Welcome to My Summer Radio :) ===</h1>
    </div>
</Layout>

<style>
    .container {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
    }

    h1 {
        text-transform: uppercase;
        font-size: 3rem;
        font-weight: 400;
        text-shadow:
            0 -0.5rem 1rem white,
            0 0.5rem 1rem #999;
    }
</style>
