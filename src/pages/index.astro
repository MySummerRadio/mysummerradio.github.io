---
import Layout from "../layouts/Layout.astro";
import Blog from "../components/Blog.astro";
import Sidebar from "../components/Sidebar.astro";
import { Image } from "astro:assets";
import logo from "../assets/images/logo-white.webp";

import { getCollection, type CollectionEntry } from "astro:content";
type SidebarEntry = CollectionEntry<"sidebars">;
const sidebars: SidebarEntry[] = await getCollection("sidebars");

const pageTitle = "My Summer Radio";
const className = "home";
---

<Layout pageTitle={pageTitle} className={className}>
    <Image
        src={logo}
        alt="my summer radio logo"
        class="logo"
        id="logo"
        style="--fit: contain; --pos: center; min-width: 0; min-height: 0; overflow: hidden;"
        height="300"
    />
    <div id="menu1"><a href="#"><h1>Downloads</h1></a></div>
    <div id="menu2"><a href="#"><h1>Stuff</h1></a></div>
    <div id="menu3"><a href="#"><h1>Blog</h1></a></div>
    <div id="menu4"><a href="#"><h1>Reviews</h1></a></div>
</Layout>

<style is:global>
    #logo {
        grid-area: logo;
        padding-block-start: 2vw;
        padding-inline-start: 2vw;
        place-self: center end;
    }

    #menu1 {
        grid-area: menu1;
        padding-block: 2vw;
        place-self: end center;
    }

    #menu2 {
        grid-area: menu2;
        padding-block: 2vw;
        place-self: center;
    }

    #menu3 {
        grid-area: menu3;
        padding-block: 2vw;
        place-self: end;
    }

    #menu4 {
        grid-area: menu4;
        padding: 2vw;
        place-self: start;
    }
</style>
