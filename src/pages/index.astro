---
import Layout from "../layouts/Layout.astro";
import Logo from "../components/Logo.astro";
const pageTitle = "My Summer Radio";
const className = "home";
const menuItems = [
    {
        label: "secrets",
        description: "(about me and what i do)",
        href: "/blog",
    },
    { label: "music", description: "(i fell in love with)", href: "/reviews" },
    {
        label: "downloads",
        description: "(you can find only here)",
        href: "/downloads",
    },
    { label: "blank", description: "(...)", href: "/reviews" },
];
---

<Layout pageTitle={pageTitle} className={className}>
    <Logo home />
    <nav class="menu">
        {
            menuItems.map((item, index) => (
                <div
                    id={`menu${index + 1}`}
                    data-label={item.label}
                    data-description={item.description}
                >
                    <a href={item.href}>{item.label.toUpperCase()}</a>
                </div>
            ))
        }
    </nav>
</Layout>

<style is:global>
    .menu {
        & > * {
            position: relative;

            /* @link https://utopia.fyi/clamp/calculator?a=320,1240,27—48 */
            --raw-fs: clamp(27px, 19.6957px + 2.2826vw, 48px);

            /* https://ishadeed.com/article/css-round/ */
            font-size: round(down, var(--raw-fs), 2px);
            font-family: var(--title-font);
            font-weight: bold;
            font-synthesis: weight;
            color: var(--dark-blue);
            transition: text-shadow 0.3s ease;

            & a {
                text-decoration: none;
            }

            @media (hover: hover) and (pointer: fine) {
                &:hover {
                    text-shadow: 0 0 0.2em var(--white);

                    &::after {
                        color: oklch(from var(--white) l c h / 1);
                        filter: blur(2px);
                    }

                    &::before {
                        letter-spacing: 0.1em;
                        filter: blur(0);
                    }

                    & a {
                        animation: squiggly 0.4s linear infinite;
                    }
                }
            }

            &::after {
                position: absolute;
                top: -0.5lh;
                left: 4vw;
                content: attr(data-label);
                font-size: 1lh;
                font-family: var(--text-font);
                font-weight: 700;
                color: oklch(from var(--white) l c h / 0.6);
                letter-spacing: 0.05em;
                z-index: -1;
                filter: blur(5px);
                transition:
                    filter 0.5s ease,
                    letter-spacing 0.5s ease,
                    color 0.5s ease;
            }

            &::before {
                position: absolute;
                bottom: 0;
                left: 2vw;
                width: 200%;
                content: attr(data-description);
                font-size: 0.3lh;
                font-family: var(--text-font);
                font-weight: 700;
                color: oklch(from var(--white) l c h / 0.9);
                letter-spacing: 0.05em;
                z-index: -1;
                filter: blur(1px);
                transition:
                    filter 0.5s ease,
                    letter-spacing 0.5s ease,
                    color 0.5s ease;
            }
        }
    }

    #menu1 {
        grid-area: menu1;
        place-self: end center;
    }

    #menu2 {
        grid-area: menu2;
        place-self: center;
    }

    #menu3 {
        grid-area: menu3;
        place-self: start center;
    }

    #menu4 {
        grid-area: menu4;
        place-self: start;
    }
</style>
